ARG PRODUCTION_IMAGE=mohankrishna999/portal-validator:1.13.12
FROM ${PRODUCTION_IMAGE} AS production
ARG APK_REPOSITORY=https://apk.cgr.dev/chainguard
ARG TARGETARCH

ENV MAX_CONCURRENT_SCANS=1

USER 0
WORKDIR /app
# Diagnostics only: curl, dig/nslookup, ip/ss and jq. openssl, certutil, ps,
# top and less already ship in the production image. TLS verification,
# authentication and network policy are unchanged. Package signatures remain
# verified by apk and the repository file is removed after the build step.
RUN --mount=type=cache,id=portal-validator-debug-apks-${TARGETARCH},target=/var/cache/apk,sharing=locked \
    set -eu; \
    printf '%s\n' "$APK_REPOSITORY" > /tmp/debug-repositories; \
    installed=0; \
    for attempt in 1 2 3 4 5; do \
      if timeout 120 env SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
        REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
        CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
        apk --repositories-file /tmp/debug-repositories \
        --cache-dir /var/cache/apk --cache-max-age 0 --timeout 60 --no-progress add \
        curl bind-tools iproute2 jq; then \
        installed=1; break; \
      fi; \
      echo "Debug package installation failed; retry $attempt" >&2; \
      sleep "$attempt"; \
    done; \
    test "$installed" = 1; \
    rm -f /tmp/debug-repositories; \
    for tool in curl dig nslookup ip ss jq openssl certutil ps top less; do command -v "$tool" >/dev/null; done
RUN --mount=type=bind,source=requirements-dev.txt,target=/tmp/requirements-dev.txt \
    set -eu; \
    glibc_version="$(awk '/^P:/ { package=substr($0,3) } /^V:/ && package ~ /^glibc(-[0-9.]+)?$/ { print substr($0,3); exit }' /usr/lib/apk/db/installed)"; \
    test -n "$glibc_version"; \
    test "$(apk version -t "$glibc_version" 2.44-r8)" != '<'; \
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt; \
    python -m ensurepip --upgrade \
    && python -m pip install --no-cache-dir --no-compile -r /tmp/requirements-dev.txt \
    && python -m pip uninstall -y pip setuptools \
    && python -c "from pathlib import Path; from playwright.sync_api import sync_playwright; manager = sync_playwright().start(); browser_path = Path(manager.chromium.executable_path); print(f'Playwright expected Chromium: {browser_path}'); assert browser_path.is_file(), f'Playwright Chromium missing: {browser_path}'; manager.stop(); print('Playwright Chromium installation verified')"

USER 10001:10001
EXPOSE 8080 5678
ENTRYPOINT ["/app/container-entrypoint.sh"]
CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
