ARG PRODUCTION_IMAGE=mohankrishna999/portal-validator:1.13.3
FROM ${PRODUCTION_IMAGE} AS production

# Resolve an exact, signed APK transaction for the diagnostic utilities against
# the production package database, without shipping download tooling.
FROM cgr.dev/chainguard/python:latest-dev@sha256:905b31747ebcae4242e0b71fcd2640c712b79a96f929811d3202b9716b66592a AS debug-packages
ARG APK_REPOSITORY=https://apk.cgr.dev/chainguard
USER 0
RUN --mount=type=bind,from=production,source=/,target=/tmp/apk-root,rw \
    set -eu; \
    mkdir -p /debug-repository/x86_64; \
    wget --https-only --prefer-family=IPv4 --timeout=30 --tries=5 \
      --retry-connrefused --retry-on-host-error \
      --retry-on-http-error=429,500,502,503,504 --quiet \
      "$APK_REPOSITORY/x86_64/APKINDEX.tar.gz" \
      -O /debug-repository/x86_64/APKINDEX.tar.gz; \
    printf '%s\n' /debug-repository > /etc/apk/repositories; \
    transaction="$(apk --root /tmp/apk-root --keys-dir /etc/apk/keys \
      --repositories-file /etc/apk/repositories --no-network --simulate --no-progress \
      add curl bind-tools iproute2 jq 2>&1)" \
      || { printf '%s\n' "$transaction" >&2; exit 1; }; \
    printf '%s\n' "$transaction"; \
    printf '%s\n' "$transaction" \
      | sed -n 's/^([^)]*) Installing \([^ ]*\) (\([^)]*\)).*/\1=\2/p' \
      > /debug-repository/constraints; \
    test -s /debug-repository/constraints; \
    for package_file in $(printf '%s\n' "$transaction" \
      | sed -n 's/^([^)]*) Installing \([^ ]*\) (\([^)]*\)).*/\1-\2.apk/p'); do \
      wget --https-only --prefer-family=IPv4 --timeout=30 --tries=5 \
        --retry-connrefused --retry-on-host-error \
        --retry-on-http-error=429,500,502,503,504 --quiet \
        "$APK_REPOSITORY/x86_64/$package_file" -O "/debug-repository/x86_64/$package_file"; \
    done

FROM production

ENV MAX_CONCURRENT_SCANS=1

USER 0
WORKDIR /app
# Diagnostics only: curl, dig/nslookup, ip/ss and jq. openssl, certutil, ps,
# top and less already ship in the production image. TLS verification,
# authentication and network policy are unchanged.
RUN --mount=type=bind,from=debug-packages,source=/debug-repository,target=/debug-repository \
    set -eu; \
    printf '%s\n' /debug-repository > /tmp/debug-repositories; \
    apk --repositories-file /tmp/debug-repositories --no-network --no-progress \
      add --no-cache $(cat /debug-repository/constraints); \
    rm -f /tmp/debug-repositories; \
    for tool in curl dig nslookup ip ss jq openssl certutil ps top less; do command -v "$tool" >/dev/null; done
RUN --mount=type=bind,source=requirements-dev.txt,target=/tmp/requirements-dev.txt \
    set -eu; \
    glibc_version="$(awk '/^P:/ { package=substr($0,3) } /^V:/ && package ~ /^glibc(-[0-9.]+)?$/ { print substr($0,3); exit }' /usr/lib/apk/db/installed)"; \
    test -n "$glibc_version"; \
    test "$(apk version -t "$glibc_version" 2.44-r8)" != '<'; \
    export SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt \
    CURL_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt; \
    python -m ensurepip --upgrade \
    && python -m pip install --no-cache-dir --no-compile -r /tmp/requirements-dev.txt \
    && python -m pip uninstall -y pip setuptools \
    && python -c "from pathlib import Path; from playwright.sync_api import sync_playwright; manager = sync_playwright().start(); browser_path = Path(manager.chromium.executable_path); print(f'Playwright expected Chromium: {browser_path}'); assert browser_path.is_file(), f'Playwright Chromium missing: {browser_path}'; manager.stop(); print('Playwright Chromium installation verified')"

USER 10001:10001
EXPOSE 8080 5678
ENTRYPOINT ["/app/container-entrypoint.sh"]
CMD ["python", "-m", "debugpy", "--listen", "0.0.0.0:5678", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]
